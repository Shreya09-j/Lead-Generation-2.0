# Copy this file to .env and fill in only the providers you use.
# The script runs without keys, but provider enrichment will be skipped.

ROCKETREACH_API_KEY=
# Optional override. Default: https://api.rocketreach.co/api/v2/person/lookup
ROCKETREACH_ENDPOINT=
ROCKETREACH_LOOKUP_TYPE=standard

LUSHA_API_KEY=
# Optional override. Default: https://api.lusha.com/v3/contacts/search-and-enrich
LUSHA_ENDPOINT=

HUNTER_API_KEY=

SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=
SNOV_MAX_POLLS=4
